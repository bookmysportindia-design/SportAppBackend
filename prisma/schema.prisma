// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GROUND_OWNER
  GROUND_MANAGER

  CAPTAIN
  PLAYER

  TOURNAMENT_OWNER
  TOURNAMENT_ADMIN

  ACADEMY_OWNER
  TEAM_OWNER
}

enum Amenity {
  PARKING 
  TOILETS
  CHANGING_ROOMS
  FIRST_AID
  WATER_FACILITY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PAID
  REFUNDED
}

enum Sport {
  CRICKET
  FOOTBALL
}

enum GroundType {
  TURF_WICKET
  MATTING_WICKET
  BOX_CRICKET
  INDOOR_NETS
}

enum SlotDuration {
  ONE_HOUR
  ONE_AND_HALF_HOURS
  TWO_HOURS
  THREE_HOURS
}

enum PitchType {
  MATCH_PITCH
  PRACTICE_NETS
  BOX_CRICKET_AREA
}

enum SurfaceType {
  TURF
  MATTING
  ASTRO_TURF
  CEMENT
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InviteType {
  INVITE        // captain → player
  JOIN_REQUEST  // player → team (captain responds)
}

enum EntityType {
  TEAM
  TOURNAMENT
  VENUE
}

enum MatchStatus {
  PAYMENT_PENDING
  UNDER_REVIEW
  SCHEDULED
  POSTPONED
  ONGOING
  COMPLETED
  CANCELLED
}

enum MatchType {
  FRIENDLY
  PRACTICE
  TOURNAMENT
}

enum MatchPaymentMethod {
  TEAM_WALLET
  SPLIT
  PAID_BY_CAPTAIN
}

model User {
  id              String   @id @default(uuid())
  phone           String   @unique
  name            String?
  email           String?  @unique
  profilePicture  String?

  roles           Role[]
  memberships     Membership[]

  venues          Venue[]  @relation("OwnerVenues")
  bookings        Booking[] 
  notifications   Notification[]
  favorites       Favorite[]

  teams           Team[]   @relation("CaptainTeams")
  initiatedInvites TeamInvite[] @relation("InitiatedInvites")
  receivedInvites  TeamInvite[] @relation("ReceivedInvites")

  initiatedMatchInvites MatchInvite[] @relation("InitiatedMatchInvites")
  receivedMatchInvites  MatchInvite[] @relation("ReceivedMatchInvites")
  matchSquads           MatchPlayer[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Venue {
  id            String        @id @default(uuid())
  name          String
  groundType    GroundType
  contactNumber String
  city          String
  state         String
  address       String
  landmark      String?
  description   String?
  latitude      Float?
  longitude     Float?
  openingTime   String
  closingTime   String
  slotDuration  SlotDuration  @default(ONE_HOUR)
  workingDays   String[]
  sportTypes    String[]
  amenities     Amenity[]
  photos        String[]

  ownerId       String
  owner         User     @relation("OwnerVenues", fields: [ownerId], references: [id])

  pitches          Pitch[]
  bankDetails      VenueBankDetails?
  documents        VenueDocument[]  // optional — venue can exist without documents
  dayPricings      DayPricing[]
  timeSlotPricings TimeSlotPricing[]
  slotTiers        SlotTier[]
  discountConfigs  DiscountConfig[]

  bookings      Booking[]
  favoritedBy   Favorite[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Otp {
  id          String   @id @default(uuid())
  phone       String
  otpHash     String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([phone])
}

model Booking {
  id              String         @id @default(uuid())
  referenceNumber String         @unique
  bookingDate     DateTime
  startTime       String
  endTime         String
  sport           Sport
  playersPerTeam  Int

  baseAmount      Int            // original price
  discountAmount  Int            @default(0)
  totalAmount     Int

  appliedOfferCode String?       // "PLAY20"
  appliedOfferTitle String?      // "20% off"

  paymentStatus   PaymentStatus  @default(PAID)
  status          BookingStatus  @default(CONFIRMED)

  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  venueId         String
  venue           Venue          @relation(fields: [venueId], references: [id])

  pitchId         String?
  pitch           Pitch?         @relation(fields: [pitchId], references: [id], onDelete: SetNull)

  matchId         String?        @unique
  match           Match?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cancelledAt     DateTime?

  @@index([userId])
  @@index([venueId])
  @@index([bookingDate])
  @@index([pitchId])
}

model Match {
  id          String      @id @default(uuid())
  status      MatchStatus @default(PAYMENT_PENDING)
  type        MatchType
  matchDate   DateTime

  teams         MatchTeam[]
  paymentMethod MatchPaymentMethod

  bookingId   String      @unique
  booking     Booking     @relation(fields: [bookingId], references: [id])

  squad       MatchPlayer[]
  invites     MatchInvite[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model MatchTeam {
  matchId String
  teamId  String

  match Match @relation(fields: [matchId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])

  @@id([matchId, teamId])
}

model MatchPlayer {
  id      String @id @default(uuid())
  matchId String
  userId  String
  teamId  String

  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
  @@index([teamId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id],onDelete: Cascade)
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, venueId]) // Prevents a user from favoriting the same venue twice
  @@index([userId])
  @@index([venueId])
}

model Team {
  id            String       @id @default(uuid())
  name          String
  city          String
  sport         Sport
  primaryGround String?
  isRecruiting  Boolean      @default(true)

  captainId     String
  captain       User         @relation("CaptainTeams", fields: [captainId], references: [id])

  invites       TeamInvite[]
  matches       MatchTeam[]
  matchPlayers  MatchPlayer[]
  matchInvites  MatchInvite[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TeamInvite {
  id          String       @id @default(uuid())
  type        InviteType
  status      InviteStatus @default(PENDING)

  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // who created this record (captain for INVITE, player for JOIN_REQUEST)
  initiatorId String
  initiator   User         @relation("InitiatedInvites", fields: [initiatorId], references: [id], onDelete: Cascade)

  // who needs to respond (player for INVITE, captain for JOIN_REQUEST)
  recipientId String
  recipient   User         @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: Cascade)

  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId])
  @@index([initiatorId])
  @@index([recipientId])
}

model MatchInvite {
  id          String       @id @default(uuid())
  type        InviteType
  status      InviteStatus @default(PENDING)

  matchId     String
  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)

  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  initiatorId String
  initiator   User         @relation("InitiatedMatchInvites", fields: [initiatorId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User         @relation("ReceivedMatchInvites", fields: [recipientId], references: [id], onDelete: Cascade)

  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([matchId])
  @@index([teamId])
  @@index([initiatorId])
  @@index([recipientId])
}

model Membership {
  id          String      @id @default(uuid())

  userId      String
  entityId    String
  entityType  EntityType
  role        Role

  user        User        @relation(fields: [userId], references: [id],onDelete: Cascade)

  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([entityId, entityType])
  @@unique([userId, entityId, entityType, role])
}

// ─── Venue Sub-models ───

model Pitch {
  id          String      @id @default(uuid())
  name        String?
  pitchType   PitchType
  surfaceType SurfaceType
  boundary    Int?

  venueId     String
  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  tierId      String?
  tier        SlotTier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)

  bookings    Booking[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([venueId])
}

model VenueBankDetails {
  id                String @id @default(uuid())
  accountNumber     String
  accountHolderName String
  ifscCode          String

  venueId           String @unique
  venue             Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model VenueDocument {
  id        String   @id @default(uuid())
  type      String
  url       String

  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([venueId])
}

// ─── Pricing Models ───

model DayPricing {
  id        String    @id @default(uuid())
  day       DayOfWeek
  basePrice Int
  isEnabled Boolean   @default(true)

  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, day])
}

model TimeSlotPricing {
  id         String @id @default(uuid())
  name       String
  startTime  String
  endTime    String
  multiplier Float

  venueId    String
  venue      Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model SlotTier {
  id          String  @id @default(uuid())
  name        String
  multiplier  Float
  description String?

  venueId     String
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  pitches     Pitch[]

  @@index([venueId])
}

model DiscountConfig {
  id           String       @id @default(uuid())
  name         String
  bookingType  MatchType
  discountType DiscountType
  value        Float

  venueId      String
  venue        Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}